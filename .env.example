# Runtime
PORT=7860
FLASK_ENV=production
APP_ENV=local
LOG_LEVEL=INFO

# Gemini generation
# Create a fresh key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GENAI_MODEL=gemini-2.5-flash

# Retrieval/model settings
EMB_MODEL=AITeamVN/Vietnamese_Embedding
TOP_K=3
SEARCH_LIMIT=10
FAISS_CANDIDATES=50
BM25_CANDIDATES=50

# Hybrid fusion strategy: rrf | weighted | legacy
#   rrf      - Reciprocal Rank Fusion, rank-only so score scales cannot leak in.
#   weighted - convex combination of min-max normalised scores (HYBRID_ALPHA).
#   legacy   - the pre-fix behaviour, kept so old reports stay reproducible.
#              Its 0.35x score term outweighs its 1/(60+rank) term by ~21x, so
#              it ranks by score despite being labelled RRF.
FUSION_STRATEGY=rrf
RRF_K=60
HYBRID_ALPHA=0.5

# Parent-document retrieval. Chunks are scored individually, so without this a
# single procedure can occupy most of the top-k with its own chunks (measured:
# 1.87 distinct procedures per top-10).
#   GROUP_KEY=parent - group chunks of one record (default, semantically safe).
#   GROUP_KEY=title  - also merges the per-province copies sharing a name.
#                      Better for readers, but it merges records the
#                      title-matching benchmark scores as one, so report which
#                      key produced any number you quote.
GROUP_BY_PROCEDURE=true
GROUP_KEY=parent
GROUP_CANDIDATE_MULTIPLIER=8

# Strip administrative lead-ins ("Xin hỏi...", "Đề nghị cho biết...") from the
# retrieval query only. The original question still reaches the answer prompt.
STRIP_QUERY_BOILERPLATE=true

# Cross-encoder reranking of the retrieved shortlist. Costs one forward pass
# per candidate, so it is off by default; enable it after measuring on your
# own hardware.
RERANK_ENABLED=false
RERANK_MODEL=AITeamVN/Vietnamese_Reranker
RERANK_CANDIDATES=20

# Data source
# hf: use Hugging Face dataset cache/download.
# local: use DATA_DIR files created by scripts/build_local_index.py.
DATA_SOURCE=hf
HF_REPO_ID=DrPie/eGoV_Data
HF_REPO_TYPE=dataset
HF_LOCAL_FILES_ONLY=false

# Local paths. These are mounted as volumes in docker-compose.yml.
CACHE_DIR=.cache
DATA_DIR=.cache/egov_data
SQLITE_PATH=user_data/egov_bot.db

# Web/API
CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
ENABLE_DEBUG_RETRIEVAL=false
ANSWER_CACHE_TTL_SECONDS=3600
ANSWER_CACHE_MAX_ITEMS=512
