# The benchmark is only reproducible if its inputs ship with the code.
# raw -> clean_v2 is the current pipeline; qa_74 reproduces the old reports.
!evaluation/testsets/dvc_faq_raw.jsonl
!evaluation/testsets/dvc_faq_clean_v2.jsonl
!evaluation/testsets/dvc_faq_qa_74.jsonl

